## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio folders
.vs/
.vscode/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# Build results
**/bin/
**/obj/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Files built by Visual Studio
*.exe
*.pdb
*.dll
*.obj
*.cache

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*

# Other
*.zip

# Claude Code worktrees and session data
.claude/

# Exception to the bin/ rules above: scripts/feedback-triage/bin/ holds source, not
# build output. ft.js is the mongosh backend that ft.ps1 shells out to, and ft.ps1
# throws without it, so it has to be tracked. The directory negation has to come
# first - a file inside an excluded directory cannot be re-included on its own.
# Everything else dropped in that folder stays ignored.
# (scripts/random-event-builder/bin/ and scripts/work-duty-builder/bin/ are genuine
#  build output - copied DLLs and a compiled .exe - and stay ignored.)
!scripts/feedback-triage/bin/
scripts/feedback-triage/bin/*
!scripts/feedback-triage/bin/ft.js
